# syntax=docker/dockerfile:1
# Production image for the Bootcamps API and worker.
# Differences from the dev Dockerfile: non-root user, no migrations/seed in CMD
# (a dedicated one-shot `migrate` service owns the schema), multiple uvicorn workers.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# uid/gid fixed so the bind-mounted var/ volume keeps stable ownership across rebuilds
RUN groupadd --gid 10001 app \
 && useradd --uid 10001 --gid app --no-create-home --home-dir /app app

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY alembic.ini .
COPY alembic ./alembic
COPY app ./app

# var/ holds generated PDFs, uploads and (when EMAIL_BACKEND=file) .eml files
RUN mkdir -p /app/var && chown -R app:app /app/var

USER app
EXPOSE 8000

# UVICORN_WORKERS is sized by the deployment (see infra/ansible/group_vars/all.yml)
ENV UVICORN_WORKERS=2
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS}"]
