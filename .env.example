# Copy to .env and fill in. Never commit .env.
# local | staging | production — in production the API refuses to start with unsafe settings
ENV=local
DATABASE_URL=postgresql+psycopg://bootcamps:bootcamps@localhost:5432/bootcamps

API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
COOKIE_SECURE=false
REQUIRE_ADMIN_MFA=true

# Stripe (test mode keys: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Google sign-in (optional). Redirect URI: {API_BASE_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: file (writes .eml files to var/mail), smtp, or console
EMAIL_BACKEND=file
EMAIL_FROM=BECOME DEVOPS <no-reply@example.com>
ADMIN_ALERT_EMAIL=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
